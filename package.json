{
  "name": "fate-core-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "npm": ">=11.17.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents": false
  },
  "overrides": {
    "workbox-build": {
      "glob": "14.0.3"
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test && playwright test -c playwright.rooms.config.ts",
    "check": "tsc -b --pretty false",
    "start": "npm run build && npm run preview",
    "signaling": "node signaling/server.mjs",
    "test:offline": "npm run build && node scripts/test-offline.mjs",
    "test:e2e:rooms": "playwright test -c playwright.rooms.config.ts"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "fflate": "^0.8.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "minisearch": "^7.1.2",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.13.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.0.0",
    "peer": "^1.0.2",
    "prettier": "^3.9.10",
    "typescript": "~5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.12"
  }
}
